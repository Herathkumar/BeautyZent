# Database (SQLite for local; use postgres://... in production)
DATABASE_URL="file:./dev.db"

# Auth
AUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# CORS / app URLs
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_POS_URL="http://localhost:3001"
NEXT_PUBLIC_STOREFRONT_URL="http://localhost:3002"
NEXT_PUBLIC_STORE_SLUG="demo-store"

# Stripe (optional — demo checkout used when unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# AI (optional — mock assistant used when unset)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Admin mobile (Expo)
# Android emulator: http://10.0.2.2:3000
# Physical phone: http://YOUR_LAN_IP:3000
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Tablet / iPad POS deploy
# Comma-separated extra browser origins allowed to call the API
CORS_ORIGINS="https://your-pos.vercel.app"
# Allow http://192.168.x.x origins while testing on store Wi‑Fi
CORS_ALLOW_LAN="true"
# POS build (apps/pos/.env)
# VITE_API_URL="https://your-api.example.com"
