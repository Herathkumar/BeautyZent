{
  "expo": {
    "name": "ZentraLab Admin",
    "slug": "zentralab-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "zentralab-admin",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f6b4c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zentralab.admin"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f6b4c"
      },
      "package": "com.zentralab.admin",
      "usesCleartextTraffic": true
    },

    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:3000"
    }
  }
}
