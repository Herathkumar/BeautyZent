generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Store {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  currency    String   @default("CAD")
  taxBps      Int      @default(1300)
  hoursJson   String   @default("{\"mon\":\"9-18\",\"tue\":\"9-18\",\"wed\":\"9-18\",\"thu\":\"9-18\",\"fri\":\"9-18\",\"sat\":\"10-16\",\"sun\":\"Closed\"}")
  policies    String   @default("Returns within 14 days with receipt.")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            User[]
  products         Product[]
  inventory        Inventory[]
  orders           Order[]
  stockMovements   StockMovement[]
  syncEvents       SyncEvent[]
  conflicts        SyncConflict[]
  chatSessions     ChatSession[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("cashier")
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  sku         String
  barcode     String?
  name        String
  description String?
  priceCents  Int
  taxBps      Int      @default(1300)
  active      Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory      Inventory?
  orderLines     OrderLine[]
  stockMovements StockMovement[]

  @@unique([storeId, sku])
  @@index([storeId, barcode])
}

model Inventory {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  productId    String   @unique
  product      Product  @relation(fields: [productId], references: [id])
  onHand       Int      @default(0)
  reserved     Int      @default(0)
  reorderPoint Int      @default(5)
  version      Int      @default(1)
  updatedAt    DateTime @updatedAt

  @@index([storeId])
}

model Order {
  id                 String   @id @default(cuid())
  clientOrderId      String?
  storeId            String
  store              Store    @relation(fields: [storeId], references: [id])
  channel            String
  status             String
  customerName       String?
  customerEmail      String?
  subtotalCents      Int
  taxCents           Int
  totalCents         Int
  tenderType         String?
  amountTenderedCents Int?
  deviceId           String?
  stripeSessionId    String?
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lines OrderLine[]

  @@unique([storeId, clientOrderId])
  @@index([storeId, status])
  @@index([customerEmail])
}

model OrderLine {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  sku            String
  name           String
  qty            Int
  unitPriceCents Int
  taxBps         Int
  lineTotalCents Int
}

model StockMovement {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  type       String
  qty        Int
  reason     String?
  orderId    String?
  deviceId   String?
  createdAt  DateTime @default(now())

  @@index([storeId, productId])
}

model SyncEvent {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  deviceId   String
  entityType String
  entityId   String
  op         String
  version    Int
  payload    String
  createdAt  DateTime @default(now())

  @@index([storeId, version])
}

model SyncMeta {
  id            String @id @default("global")
  serverVersion Int    @default(0)
}

model SyncConflict {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  productId   String?
  entityId    String
  message     String
  onHand      Int?
  status      String   @default("open")
  resolution  String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([storeId, status])
}

model ChatSession {
  id        String        @id @default(cuid())
  storeId   String?
  store     Store?        @relation(fields: [storeId], references: [id])
  role      String
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  toolCalls String?
  createdAt DateTime    @default(now())
}
