{
  "name": "zentralab-pos",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @zentralab/web db:generate",
    "db:push": "pnpm --filter @zentralab/web db:push",
    "db:seed": "pnpm --filter @zentralab/web db:seed",
    "db:setup": "pnpm db:generate && pnpm db:push && pnpm db:seed",
    "mobile": "pnpm --filter @zentralab/admin-mobile start",
    "pos:build": "pnpm --filter @zentralab/pos build",
    "pos:preview": "pnpm --filter @zentralab/pos preview"
  },

  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
