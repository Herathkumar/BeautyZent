# Local + production: use Neon (or any Postgres). SQLite is not used in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

AUTH_SECRET="replace-with-long-random-string-at-least-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_SALON_SLUG="fhsalon"
# Marketing site for /demo hub and “Visit website”
NEXT_PUBLIC_MARKETING_URL="https://www.fhsalon.ca"

# Google Calendar (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/google/callback"
