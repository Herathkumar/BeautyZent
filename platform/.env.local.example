# Copy to platform/.env.local for local multi-salon development.
# .env.local overrides .env, so the Neon URL in .env is never touched by `pnpm dev:local`.

# Matches docker-compose.yml and `pnpm db:local:up` (embedded Postgres).
DATABASE_URL="postgresql://salonbook:salonbook@127.0.0.1:55433/salonbook"

AUTH_SECRET="local-dev-secret-change-me-at-least-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_SALON_SLUG="fhsalon"
NEXT_PUBLIC_MARKETING_URL="https://www.fhsalon.ca"

# Platform operator console at /platform.
# Seeded into the PlatformAdmin table by `pnpm db:local:seed`; the same values also
# work as a database-free fallback login.
PLATFORM_ADMIN_EMAIL="platform@salonbook.local"
PLATFORM_ADMIN_PASSWORD="demo1234"
PLATFORM_ADMIN_NAME="Platform Admin"
# Optional — separate signing key for the platform cookie (defaults to AUTH_SECRET).
PLATFORM_AUTH_SECRET=""
