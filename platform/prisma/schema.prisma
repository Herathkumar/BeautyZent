generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Multi-tenant business (salon, barber, spa, nails, …). Ops still use Salon tables.
model Salon {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  phone        String?
  email        String?
  address      String?
  timezone     String   @default("America/Toronto")
  /// Operational pause — booking/display off without deleting data.
  active       Boolean  @default(true)
  /// Marketplace listing: DRAFT (pending) | PUBLISHED | REJECTED
  listingStatus String  @default("PUBLISHED")
  /// Vertical: SALON | BARBER | SPA | NAILS | OTHER
  businessType  String  @default("SALON")
  city          String?
  region        String?
  country       String? @default("CA")
  lat           Float?
  lng           Float?
  description   String?
  coverMime     String?
  coverData     Bytes?
  coverUpdatedAt DateTime?
  claimedAt     DateTime?
  approvedAt    DateTime?
  approvedById  String?
  /// Last reject reason from platform review. Kept after resubmit so admins see prior feedback.
  listingReviewNote String?
  listingReviewedAt DateTime?
  /// Legacy accent colours — still used for stylist chips and splash tinting.
  brandColor   String?
  accentColor  String?
  /// Theme pack per app, chosen in the platform portal (see src/lib/salon-themes.ts).
  bookingThemeId String @default("plum")
  managerThemeId String @default("cocoa")
  stylistThemeId String @default("seaglass")
  openHour     Int      @default(9)
  closeHour    Int      @default(18)
  /// Days the store is closed by default (0=Sun … 6=Sat). Used for new stylist schedules.
  closedDays   Int[]    @default([0])
  slotMinutes  Int      @default(30)
  /// Sales tax on services and products (Ontario HST is 13). Tip is not taxed.
  taxPercent   Int      @default(13)
  /// Weekly store profit goal for manager Store Earnings ring (cents)
  weeklyProfitGoalCents Int? @default(200000)
  /// bcrypt hash of the store-display tablet PIN (null = board unlocked / no PIN)
  displayPinHash   String?
  displayPinSetAt  DateTime?
  /// Default customer TV layout when control is "manual": "lounge" or "timeline".
  /// A tablet can override this locally (see src/lib/customer-display-view.ts).
  displayViewMode  String   @default("lounge")
  /// How the customer TV picks Lounge vs Schedule:
  /// "manual" (tablet switch), "lounge", "timeline", or "rotate".
  displayViewControl   String @default("manual")
  /// Seconds between Lounge ↔ Schedule when displayViewControl is "rotate".
  displayViewRotateSec Int    @default(60)
  /// Loyalty points earn/redeem at checkout (members only).
  loyaltyEnabled          Boolean @default(false)
  discountsEnabled        Boolean @default(false)
  loyaltyPointsPerDollar  Int     @default(1)
  loyaltyCentsPerPoint    Int     @default(5)
  loyaltyMaxRedeemPercent Int     @default(50)
  /// Show checkout details overlay on the customer display
  displayCheckoutEnabled  Boolean @default(true)
  /// Customer TV promotion board — rotates enabled discount templates.
  promoBoardEnabled     Boolean @default(false)
  /// Seconds between promotion board appearances on the customer display.
  promoBoardIntervalSec Int     @default(90)
  /// How long the full promotion board stays on screen each appearance.
  promoBoardShowSec     Int     @default(24)
  /// Default seconds each slide stays on screen during a board cycle.
  promoBoardSlideSec    Int     @default(8)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  stylists     Stylist[]
  services     Service[]
  products     Product[]
  clients      Client[]
  clientOtps   ClientOtp[]
  appointments Appointment[]
  payouts      StylistPayout[]
  waitlist     WalkInWaitlist[]
  lookPhotos   AppointmentPhoto[]
  stylePrefs   AppointmentStylePref[]
  styleAiUsage StyleAiUsage[]
  promotionRules PromotionRule[]
  consumerFavorites ConsumerFavorite[]
}

/// Global consumer identity — one email across many business memberships (Client rows).
model ConsumerAccount {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  phone           String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  clients Client[]
  otps    ConsumerOtp[]
  favorites ConsumerFavorite[]
}

/// Businesses saved by a marketplace consumer.
model ConsumerFavorite {
  id        String   @id @default(cuid())
  accountId String
  salonId   String
  createdAt DateTime @default(now())

  account ConsumerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  salon   Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([accountId, salonId])
  @@index([salonId])
}

/// Platform-wide OTP (sign in once, then pick a business membership).
model ConsumerOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  purpose   String   @default("signin") // signin | join
  name      String?
  phone     String?
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  accountId String?
  account   ConsumerAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
}

/// Platform operator login — separate from salon staff (User) so tenant auth is untouched.
model PlatformAdmin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String    @default("Platform Admin")
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Guests waiting for a walk-in chair (Phase 3)
model WalkInWaitlist {
  id               String    @id @default(cuid())
  salonId          String
  clientName       String
  clientPhone      String?
  serviceId        String?
  /// Preferred stylist; null = next available
  stylistId        String?
  note             String?
  /// WAITING | SEATED | CANCELLED | EXPIRED
  status           String    @default("WAITING")
  estimatedWaitMin Int?
  appointmentId    String?
  createdAt        DateTime  @default(now())
  seatedAt         DateTime?
  cancelledAt      DateTime?

  salon   Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  stylist Stylist? @relation(fields: [stylistId], references: [id], onDelete: SetNull)

  @@index([salonId, status, createdAt])
}

model User {
  id           String   @id @default(cuid())
  salonId      String
  email        String
  passwordHash String
  name         String
  /// Personal phone shown on their account profile (manager or stylist).
  phone        String?
  /// Short about / bio for their account profile.
  bio          String?
  role         String   @default("ADMIN") // ADMIN | MANAGER | FRONT_DESK | STYLIST (UI: Manager)
  /// When role is STYLIST, links this login to a stylist profile
  stylistId    String?  @unique
  /// Manager/admin selfie for the account page (JPEG/PNG, client-resized).
  photoData      Bytes?
  photoMime      String?
  photoUpdatedAt DateTime?
  createdAt    DateTime @default(now())

  salon   Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylist Stylist? @relation(fields: [stylistId], references: [id], onDelete: SetNull)

  @@unique([salonId, email])
}

/// Used for default avatar when the stylist has not uploaded a selfie yet.
enum StylistGender {
  FEMALE
  MALE
  UNSPECIFIED
}

model Stylist {
  id                   String        @id @default(cuid())
  salonId              String
  name                 String
  bio                  String?
  /// Public Instagram handle or profile URL shown to booking clients.
  instagram            String?
  /// Public Facebook handle/page or profile URL shown to booking clients.
  facebook             String?
  color                String        @default("#6e4a38")
  gender               StylistGender @default(UNSPECIFIED)
  /// JPEG/PNG bytes for booking + portal selfie (kept small via client resize).
  photoData            Bytes?
  photoMime            String?
  photoUpdatedAt       DateTime?
  active               Boolean       @default(true)
  /// When set, stylist is removed from the team list (kept for appointment history).
  removedAt            DateTime?
  /// Google Calendar OAuth tokens (JSON). When set, bookings sync to phone calendar.
  googleRefreshToken   String?
  googleCalendarId     String?       @default("primary")
  googleConnectedAt    DateTime?
  /// Special stylists: leave/blocks and week hours apply without admin approval.
  selfManageSchedule   Boolean       @default(false)
  /// HOURLY | COMMISSION | BOTH
  payType              String        @default("COMMISSION")
  hourlyRateCents      Int?
  /// Commission in basis points (5000 = 50%)
  commissionBps        Int?          @default(5000)
  /// Weekly earnings goal for stylist Earnings ring (cents)
  weeklyGoalCents      Int?          @default(50000)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user         User?
  services     StylistService[]
  appointments Appointment[]
  weekHours    StylistWeekHour[]
  blocks       StylistBlock[]
  payouts      StylistPayout[]
  waitlist     WalkInWaitlist[]
}

/// Weekly working hours per stylist (0 = Sunday … 6 = Saturday)
model StylistWeekHour {
  id         String  @id @default(cuid())
  stylistId  String
  dayOfWeek  Int
  startHour  Int     @default(9)
  startMinute Int    @default(0)
  endHour    Int     @default(18)
  endMinute  Int     @default(0)
  isOff      Boolean @default(false)

  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@unique([stylistId, dayOfWeek])
}

/// Leave, vacation, lunch, or blocked time — hidden from client booking when PENDING/APPROVED
model StylistBlock {
  id           String    @id @default(cuid())
  stylistId    String
  startsAt     DateTime
  endsAt       DateTime
  reason       String    @default("LEAVE") // LEAVE | BREAK | BLOCKED | OTHER
  note         String?
  /// PENDING | APPROVED | REJECTED
  status       String    @default("APPROVED")
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime  @default(now())

  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@index([stylistId, startsAt])
  @@index([stylistId, status])
}

model Service {
  id          String   @id @default(cuid())
  salonId     String
  name        String
  description String?
  category    String   @default("HAIRCUT") // WOMEN | MEN | HAIRCUT | OTHER
  durationMin Int      @default(45)
  priceCents  Int
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  /// Display / menu image (JPEG/PNG), often AI-generated by manager.
  imageData      Bytes?
  imageMime      String?
  imageUpdatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salon    Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylists StylistService[]
  appointments Appointment[]
  waitlist WalkInWaitlist[]
}

model StylistService {
  stylistId String
  serviceId String

  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([stylistId, serviceId])
}

model Product {
  id          String   @id @default(cuid())
  salonId     String
  name        String
  description String?
  sku         String?
  priceCents  Int
  stockQty    Int      @default(0)
  active      Boolean  @default(true)
  /// Retail shelf photo (JPEG/PNG) — camera, gallery, or AI.
  imageData      Bytes?
  imageMime      String?
  imageUpdatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
}

model Client {
  id                 String    @id @default(cuid())
  salonId            String
  /// Optional link to global ConsumerAccount (same email across businesses).
  accountId          String?
  name               String
  phone              String?
  email              String?
  notes              String?
  /// When set, this client is a salon member (email OTP verified).
  memberAt           DateTime?
  /// Member selfie for the FHS Client app profile (JPEG/PNG, resized in browser).
  photoData          Bytes?
  photoMime          String?
  photoUpdatedAt     DateTime?
  preferredStylistId String?
  /// Redeemable loyalty balance (members only when loyaltyEnabled).
  loyaltyPoints      Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  salon        Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  account      ConsumerAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  lookPhotos   AppointmentPhoto[]
  stylePrefs   AppointmentStylePref[]

  @@index([salonId, phone])
  @@index([salonId, email])
  @@index([accountId])
}

/// Salon discount rules — manager-configured, auto-applied at checkout.
model PromotionRule {
  id            String   @id @default(cuid())
  salonId       String
  /// MEMBER_PERCENT | FIRST_VISIT | VISIT_MILESTONE | MIN_SPEND_PERCENT | MIN_SPEND_FLAT
  type          String
  name          String
  enabled       Boolean  @default(true)
  discountBps   Int?
  discountCents Int?
  minVisits     Int?
  minSpendCents Int?
  membersOnly   Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, enabled, sortOrder])
}

/// Short-lived email OTP codes for public client membership.
model ClientOtp {
  id        String   @id @default(cuid())
  salonId   String
  email     String
  codeHash  String
  purpose   String   @default("signin") // signin | join
  name      String?
  phone     String?
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, email])
}

model Appointment {
  id               String   @id @default(cuid())
  salonId          String
  stylistId        String
  serviceId        String
  clientId         String
  startsAt         DateTime
  endsAt           DateTime
  status           String   @default("BOOKED") // BOOKED | CHECKED_IN | COMPLETED | CANCELLED | NO_SHOW
  source           String   @default("ONLINE") // ONLINE | WALK_IN | PHONE | ADMIN
  /// Shared id when one online booking includes multiple back-to-back services.
  bookingGroupId   String?
  notes            String?
  /// Amount actually charged for the service when completed (cents).
  chargedCents     Int?
  /// Tip given to the stylist (cents) — counts fully toward stylist earnings.
  tipCents         Int?
  chargedAt        DateTime?
  chargedByUserId  String?
  /// Manager voided this job — excluded from store + stylist commission/tip totals.
  excludedFromEarnings Boolean   @default(false)
  excludedAt           DateTime?
  excludedByUserId     String?
  /// Auto discount applied at checkout (cents, before loyalty redeem).
  discountCents        Int?
  discountLabel        String?
  loyaltyPointsEarned  Int?
  loyaltyPointsRedeemed Int?
  /// Google Calendar event id for sync
  googleEventId    String?
  calendarSyncedAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  salon   Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lookPhotos AppointmentPhoto[]
  stylePref  AppointmentStylePref?

  @@index([salonId, startsAt])
  @@index([stylistId, startsAt])
  @@index([stylistId, status, startsAt])
  @@index([bookingGroupId])
}

/// Client-chosen preferred look for an upcoming visit (upload, look-book, or AI).
model AppointmentStylePref {
  id            String   @id @default(cuid())
  salonId       String
  appointmentId String   @unique
  clientId      String
  photoData     Bytes
  photoMime     String   @default("image/jpeg")
  /// UPLOAD | LOOKBOOK | AI
  source        String   @default("UPLOAD")
  prompt        String?
  createdAt     DateTime @default(now())

  salon       Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

/// Daily AI style-preview generation counters (free-tier guardrail).
model StyleAiUsage {
  id        String   @id @default(cuid())
  salonId   String
  /// clientId when signed in, else "ip:<hash>"
  usageKey  String
  day       String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, usageKey, day])
  @@index([salonId, day])
}

/// Client-uploaded "look book" photo of a finished visit (member style journal).
model AppointmentPhoto {
  id            String   @id @default(cuid())
  salonId       String
  appointmentId String
  clientId      String
  /// JPEG/PNG bytes, resized on the client before upload.
  photoData     Bytes
  photoMime     String   @default("image/jpeg")
  caption       String?
  createdAt     DateTime @default(now())

  salon       Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([appointmentId])
}

/// Admin payout record for a stylist pay period
model StylistPayout {
  id          String    @id @default(cuid())
  salonId     String
  stylistId   String
  periodStart DateTime
  periodEnd   DateTime
  amountCents Int
  note        String?
  status      String    @default("PAID") // DRAFT | PAID
  paidAt      DateTime?
  /// When stylist opens Earnings after a payout, we set this (clears nav badge).
  seenByStylistAt DateTime?
  createdAt   DateTime  @default(now())

  salon   Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@index([salonId, stylistId, periodStart])
}
