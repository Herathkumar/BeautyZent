generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Multi-tenant salon (pilot: Farzana Hair Salon; scalable to many salons)
model Salon {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  phone        String?
  email        String?
  address      String?
  timezone     String   @default("America/Toronto")
  openHour     Int      @default(9)
  closeHour    Int      @default(18)
  slotMinutes  Int      @default(30)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  stylists     Stylist[]
  services     Service[]
  products     Product[]
  clients      Client[]
  appointments Appointment[]
  payouts      StylistPayout[]
}

model User {
  id           String   @id @default(cuid())
  salonId      String
  email        String
  passwordHash String
  name         String
  role         String   @default("ADMIN") // ADMIN | FRONT_DESK | STYLIST
  /// When role is STYLIST, links this login to a stylist profile
  stylistId    String?  @unique
  createdAt    DateTime @default(now())

  salon   Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylist Stylist? @relation(fields: [stylistId], references: [id], onDelete: SetNull)

  @@unique([salonId, email])
}

/// Used for default avatar when the stylist has not uploaded a selfie yet.
enum StylistGender {
  FEMALE
  MALE
  UNSPECIFIED
}

model Stylist {
  id                   String        @id @default(cuid())
  salonId              String
  name                 String
  bio                  String?
  color                String        @default("#6e4a38")
  gender               StylistGender @default(UNSPECIFIED)
  /// JPEG/PNG bytes for booking + portal selfie (kept small via client resize).
  photoData            Bytes?
  photoMime            String?
  photoUpdatedAt       DateTime?
  active               Boolean       @default(true)
  /// Google Calendar OAuth tokens (JSON). When set, bookings sync to phone calendar.
  googleRefreshToken   String?
  googleCalendarId     String?       @default("primary")
  googleConnectedAt    DateTime?
  /// Special stylists: leave/blocks and week hours apply without admin approval.
  selfManageSchedule   Boolean       @default(false)
  /// HOURLY | COMMISSION | BOTH
  payType              String        @default("COMMISSION")
  hourlyRateCents      Int?
  /// Commission in basis points (5000 = 50%)
  commissionBps        Int?          @default(5000)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user         User?
  services     StylistService[]
  appointments Appointment[]
  weekHours    StylistWeekHour[]
  blocks       StylistBlock[]
  payouts      StylistPayout[]
}

/// Weekly working hours per stylist (0 = Sunday … 6 = Saturday)
model StylistWeekHour {
  id         String  @id @default(cuid())
  stylistId  String
  dayOfWeek  Int
  startHour  Int     @default(9)
  startMinute Int    @default(0)
  endHour    Int     @default(18)
  endMinute  Int     @default(0)
  isOff      Boolean @default(false)

  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@unique([stylistId, dayOfWeek])
}

/// Leave, vacation, lunch, or blocked time — hidden from client booking when PENDING/APPROVED
model StylistBlock {
  id           String    @id @default(cuid())
  stylistId    String
  startsAt     DateTime
  endsAt       DateTime
  reason       String    @default("LEAVE") // LEAVE | BREAK | BLOCKED | OTHER
  note         String?
  /// PENDING | APPROVED | REJECTED
  status       String    @default("APPROVED")
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime  @default(now())

  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@index([stylistId, startsAt])
  @@index([stylistId, status])
}

model Service {
  id          String   @id @default(cuid())
  salonId     String
  name        String
  description String?
  category    String   @default("HAIRCUT") // WOMEN | MEN | HAIRCUT | OTHER
  durationMin Int      @default(45)
  priceCents  Int
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salon    Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylists StylistService[]
  appointments Appointment[]
}

model StylistService {
  stylistId String
  serviceId String

  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([stylistId, serviceId])
}

model Product {
  id          String   @id @default(cuid())
  salonId     String
  name        String
  description String?
  sku         String?
  priceCents  Int
  stockQty    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
}

model Client {
  id        String   @id @default(cuid())
  salonId   String
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([salonId, phone])
}

model Appointment {
  id               String   @id @default(cuid())
  salonId          String
  stylistId        String
  serviceId        String
  clientId         String
  startsAt         DateTime
  endsAt           DateTime
  status           String   @default("BOOKED") // BOOKED | CHECKED_IN | COMPLETED | CANCELLED | NO_SHOW
  source           String   @default("ONLINE") // ONLINE | WALK_IN | PHONE | ADMIN
  notes            String?
  /// Amount actually charged when completed (cents). Prefills from service price.
  chargedCents     Int?
  chargedAt        DateTime?
  chargedByUserId  String?
  /// Google Calendar event id for sync
  googleEventId    String?
  calendarSyncedAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  salon   Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([salonId, startsAt])
  @@index([stylistId, startsAt])
  @@index([stylistId, status, startsAt])
}

/// Admin payout record for a stylist pay period
model StylistPayout {
  id          String    @id @default(cuid())
  salonId     String
  stylistId   String
  periodStart DateTime
  periodEnd   DateTime
  amountCents Int
  note        String?
  status      String    @default("PAID") // DRAFT | PAID
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  salon   Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@index([salonId, stylistId, periodStart])
}
