{
  "name": "Salon Manager",
  "short_name": "Salon Manager",
  "description": "Dashboard, bookings, earnings, and team for your salon.",
  "id": "/manager",
  "start_url": "/shells/manager.html?next=/manager",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "orientation": "any",
  "background_color": "#f3ebe3",
  "theme_color": "#f3ebe3",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/manager-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/manager-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/manager-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
