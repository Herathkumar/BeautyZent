{
  "name": "FHSalon — Stylist App",
  "short_name": "FHSalon Stylist",
  "description": "Stylist phone app for today's bookings, check-in, and time off.",
  "start_url": "/stylist",
  "scope": "/stylist",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0e1618",
  "theme_color": "#0e1618",
  "icons": [
    {
      "src": "/stylist-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/stylist-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/stylist-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
