{
  "name": "Stylist App",
  "short_name": "Stylist App",
  "description": "Stylist phone app for today's bookings, check-in, and time off.",
  "id": "/stylist",
  "start_url": "/shells/stylist.html?next=/stylist",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "orientation": "portrait",
  "background_color": "#f6f2eb",
  "theme_color": "#f6f2eb",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/stylist-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/stylist-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/stylist-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
